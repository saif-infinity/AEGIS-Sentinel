new file mode 100644
index 0000000..317e7cb
--- /dev/null
+++ b/backend/tests/conftest.py
@@ -0,0 +1,49 @@
+"""Pytest configuration — makes the suite importable and hermetic.
+
+Why this file exists
+--------------------
+`app/core/config.py` declares 8 fields with NO default:
+
+    JWT_SECRET_KEY, API_KEY, WAZUH_PASS, WAZUH_INDEXER_PASS,
+    SURICATA_PASS, WAZUH_SSH_PASS, ADMIN_API_KEY, ADMIN_JWT_SECRET
+
+`Settings` is instantiated at *import time* (`settings = Settings()`), so every one
+of the 14 existing test modules fails at COLLECTION with a pydantic ValidationError
+before a single test runs (verified: `pytest --collect-only tests/test_timescale.py`
+on a clean checkout errors out). CI supplied only 4 of the 8 and there was no
+conftest, so the `test-backend` job could never have passed.
+
+Contract: values already present in the environment WIN (CI supplies a real
+PostgreSQL/TimescaleDB DSN and a Redis URL). Everything else gets a throwaway
+default so `pytest` works on a laptop with no `.env` file.
+"""
+import os
+
+# Must happen before any `app.*` import — pytest loads conftest.py first.
+_TEST_DEFAULTS = {
+    # ── the 8 required secrets ────────────────────────────────────────────
+    "JWT_SECRET_KEY": "test-only-jwt-secret-not-for-production-0000000000",
+    "API_KEY": "test-only-api-key",
+    "ADMIN_API_KEY": "test-only-admin-api-key",
+    "ADMIN_JWT_SECRET": "test-only-admin-jwt-secret-0000000000000000000",
+    "WAZUH_PASS": "test-only",
+    "WAZUH_INDEXER_PASS": "test-only",
+    "SURICATA_PASS": "test-only",
+    "WAZUH_SSH_PASS": "test-only",
+    # ── infrastructure the suite talks to (CI overrides both) ─────────────
+    "DATABASE_URL": "postgresql+pg8000://postgres:test-password-ci-only@localhost:5432/postgres_test",
+    "REDIS_URL": "redis://localhost:6379/0",
+    # ── never let a test run believe it is in production ──────────────────
+    "ENVIRONMENT": "test",
+    # ── keep optional integrations OFF so tests do not hit the network ────
+    "ENABLE_WAZUH_SOURCE": "False",
+    "ENABLE_SURICATA_SOURCE": "False",
+    "ENABLE_HOST_AGENT_SOURCE": "False",
+    "THREAT_INTEL_ENABLED": "false",
+    "REGISTRATION_REQUIRES_APPROVAL": "False",
+    # No SUPER_ADMIN_PASSWORD: bootstrap.run_startup() must not seed an account
+    # during tests (it logs a warning instead).
+}
+
+for _key, _value in _TEST_DEFAULTS.items():
+    os.environ.setdefault(_key, _value)
diff --git a/backend/tests/test_database_admin_ddl.py b/backend/tests/test_database_admin_ddl.py
new file mode 100644
index 0000000..27b880d
--- /dev/null
+++ b/backend/tests/test_database_admin_ddl.py
@@ -0,0 +1,98 @@
+"""Regression tests for the admin database-browser DDL endpoints.
+
+Two things were broken before:
+  * `ALLOWED_TYPES` was declared but NEVER used — `col.type` and `col.default`
+    were interpolated straight into `CREATE TABLE`, i.e. SQL injection from the
+    admin console.
+  * `PROTECTED_TABLES` was a hand-maintained list of 25 names while the ORM
+    declares 46 tables, so 22 real tables were droppable over HTTP.
+
+Run: cd backend && pytest tests/test_database_admin_ddl.py -q
+"""
+import pytest
+from fastapi import HTTPException
+
+from app.core.db import Base
+from app.interface.api.database import (
+    ALLOWED_TYPES,
+    _protected_tables,
+    _validate_column_type,
+    _validate_default,
+)
+
+
+# ── column types ───────────────────────────────────────────────────────
+@pytest.mark.parametrize("raw,expected", [
+    ("text", "TEXT"),
+    ("TEXT", "TEXT"),
+    ("  varchar(255) ", "VARCHAR(255)"),
+    ("character varying(64)", "CHARACTER VARYING(64)"),
+    ("numeric(10,2)", "NUMERIC(10, 2)"),
+    ("timestamp with time zone", "TIMESTAMP WITH TIME ZONE"),
+    ("double precision", "DOUBLE PRECISION"),
+    ("jsonb", "JSONB"),
+    ("uuid", "UUID"),
+    ("boolean", "BOOLEAN"),
+])
+def test_accepts_and_normalises_allowed_types(raw, expected):
+    assert _validate_column_type(raw) == expected
+
+
+@pytest.mark.parametrize("raw", [
+    "integer); DROP TABLE tenants; --",
+    "text DEFAULT (SELECT password_hash FROM tenant_users LIMIT 1)",
+    "varchar(255); DELETE FROM alerts",
+    "integer PRIMARY KEY",          # constraints come from the dedicated fields
+    "serial",                       # not in ALLOWED_TYPES
+    "text(10)",                     # text takes no size modifier
+    "pg_sleep(10)",
+    "",
+])
+def test_rejects_injected_or_unlisted_types(raw):
+    with pytest.raises(HTTPException) as exc:
+        _validate_column_type(raw)
+    assert exc.value.status_code == 400
+
+
+# ── defaults ───────────────────────────────────────────────────────────
+@pytest.mark.parametrize("raw", ["now()", "CURRENT_TIMESTAMP", "gen_random_uuid()", "0", "-1.5", "'pending'", "true", "false"])
+def test_accepts_safe_defaults(raw):
+    assert _validate_default(raw)
+
+
+@pytest.mark.parametrize("raw", [
+    "(SELECT 1)",
+    "now()); DROP TABLE tenants; --",
+    "'a'; DROP TABLE tenants; --",
+    "gen_random_uuid()::text",
+    "current_user",
+])
+def test_rejects_expression_defaults(raw):
+    with pytest.raises(HTTPException) as exc:
+        _validate_default(raw)
+    assert exc.value.status_code == 400
+
+
+# ── protected tables can no longer drift ───────────────────────────────
+def test_every_orm_table_is_protected_from_drop():
+    declared = set(Base.metadata.tables.keys())
+    assert declared, "ORM metadata is empty — models were not imported"
+    protected = _protected_tables()
+    missing = sorted(declared - protected)
+    assert not missing, f"these application tables are droppable over HTTP: {missing}"
+
+
+@pytest.mark.parametrize("table", [
+    "tenants", "tenant_users", "alerts", "cases", "investigations",
+    "response_runs", "registration_requests", "notification_channels",
+    "honeypot_events", "agents",
+])
+def test_sensitive_tables_are_protected(table):
+    assert table in _protected_tables()
+
+
+def test_allowed_types_is_actually_enforced():
+    # The set existed before but nothing consulted it; make sure that cannot regress.
+    assert "text" in ALLOWED_TYPES
+    with pytest.raises(HTTPException):
+        _validate_column_type("definitely_not_a_pg_type")
diff --git a/backend/tests/test_terminal_sanitizer.py b/backend/tests/test_terminal_sanitizer.py
new file mode 100644
index 0000000..340d37d
--- /dev/null
+++ b/backend/tests/test_terminal_sanitizer.py
@@ -0,0 +1,123 @@
+"""Regression tests for the restricted terminal sanitizer.
+
+These lock in the fixes for the four bypasses that existed before:
+  1. `docker` in the allowlist  -> container escape / root on the host
+  2. `find /var/log -exec …`    -> only parts[1] was path-checked
+  3. `grep -r root /etc/shadow` -> no path restriction at all
+  4. `systemctl edit …`         -> writing a unit file = code execution
+
+Run: cd backend && pytest tests/test_terminal_sanitizer.py -q
+"""
+import pytest
+
+from app.interface.api.terminal import ALLOWED_COMMANDS, sanitize_command
+
+
+# ── legitimate diagnostics must keep working ────────────────────────────
+@pytest.mark.parametrize("cmd,target", [
+    ("cat /var/ossec/logs/ossec.log", "wazuh"),
+    ("tail -n 100 /var/ossec/logs/ossec.log", "wazuh"),
+    ("head -20 /var/log/syslog", "wazuh"),
+    ("ls /var/log", "wazuh"),
+    ("ls /var/log/", "wazuh"),
+    ("journalctl -u wazuh-manager --no-pager", "wazuh"),
+    ("systemctl status wazuh-manager", "wazuh"),
+    ("systemctl is-active wazuh-manager", "wazuh"),
+    ("ps aux", "wazuh"),
+    ("ss -tulpn", "wazuh"),
+    ("df -h", "suricata"),
+    ("uptime", "suricata"),
+    ("suricatasc -c ps", "suricata"),
+    ("cat /etc/suricata/suricata.yaml", "suricata"),
+])
+def test_allows_legitimate_diagnostics(cmd, target):
+    assert sanitize_command(cmd, target) == cmd
+
+
+# ── the four historical bypasses ────────────────────────────────────────
+@pytest.mark.parametrize("cmd,target", [
+    # 1. docker / container escape
+    ("docker run --privileged -v /:/host alpine chroot /host", "wazuh"),
+    ("docker ps", "wazuh"),
+    # 2. find -exec / -delete (and the `+` terminator that was not blocked)
+    ("find /var/log -type f -exec cat /etc/shadow +", "wazuh"),
+    ("find /var/log -delete", "wazuh"),
+    ("find /var/log -execdir id ;", "wazuh"),
+    # 3. unrestricted readers
+    ("grep -r root /etc/shadow", "wazuh"),
+    ("grep password /etc/suricata/suricata.yaml", "suricata"),
+    # 4. systemctl as a write primitive
+    ("systemctl edit wazuh-manager", "wazuh"),
+    ("systemctl set-property wazuh CPUQuota=1%", "wazuh"),
+])
+def test_blocks_the_known_bypasses(cmd, target):
+    with pytest.raises(ValueError):
+        sanitize_command(cmd, target)
+
+
+# ── path confinement for every reading command ──────────────────────────
+@pytest.mark.parametrize("cmd", [
+    "cat /etc/shadow",
+    "cat /etc/passwd",
+    "tail -f /root/.ssh/id_rsa",
+    "head /var/ossec/etc/../../etc/shadow",
+    "ls /etc",
+])
+def test_blocks_paths_outside_the_safe_directories(cmd):
+    with pytest.raises(ValueError):
+        sanitize_command(cmd, "wazuh")
+
+
+def test_blocks_path_traversal_even_inside_a_safe_prefix():
+    with pytest.raises(ValueError):
+        sanitize_command("cat /var/log/../../etc/shadow", "wazuh")
+
+
+# ── flag-level confinement ─────────────────────────────────────────────
+@pytest.mark.parametrize("cmd", [
+    "journalctl --file=/etc/shadow",
+    "journalctl --directory=/etc",
+    "cat -o /var/log/syslog",
+])
+def test_blocks_dangerous_flags(cmd):
+    with pytest.raises(ValueError):
+        sanitize_command(cmd, "wazuh")
+
+
+# ── shell metacharacters and size limit (pre-existing behaviour kept) ───
+@pytest.mark.parametrize("cmd", [
+    "cat /var/log/syslog | grep root",
+    "cat /var/log/syslog; reboot",
+    "cat $(whoami)",
+    "cat `id`",
+    "cat /var/log/syslog && curl http://evil",
+])
+def test_blocks_shell_metacharacters(cmd):
+    with pytest.raises(ValueError):
+        sanitize_command(cmd, "wazuh")
+
+
+def test_rejects_overlong_commands():
+    with pytest.raises(ValueError):
+        sanitize_command("cat " + "/var/log/" + "a" * 600, "wazuh")
+
+
+def test_rejects_empty_and_unknown_commands():
+    with pytest.raises(ValueError):
+        sanitize_command("   ", "wazuh")
+    with pytest.raises(ValueError):
+        sanitize_command("reboot", "wazuh")
+    with pytest.raises(ValueError):
+        sanitize_command("cat /etc/passwd", "not-a-target")
+
+
+def test_no_interactive_or_docker_binaries_in_any_allowlist():
+    for target, allowed in ALLOWED_COMMANDS.items():
+        for binary in ("docker", "grep", "find", "top", "htop", "sh", "bash", "python", "curl", "wget"):
+            assert binary not in allowed, f"{binary} must not be reachable via the {target} terminal"
+        # every two-word entry must actually be reachable by the prefix matcher
+        for entry in allowed:
+            if " " in entry:
+                assert entry.split()[0] not in allowed, (
+                    f"'{entry}' is shadowed by the bare '{entry.split()[0]}' allowlist entry"
+                )
