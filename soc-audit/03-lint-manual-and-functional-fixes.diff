+      radial-gradient(1200px 600px at 20% -10%, rgba(0, 255, 136, 0.06) 0%, transparent 60%),
+      radial-gradient(800px 400px at 80% 10%, rgba(0, 229, 255, 0.04) 0%, transparent 55%),
+      linear-gradient(180deg, var(--bg-1), var(--bg-0));
+    color: var(--text-1);
+    font-family: 'JetBrains Mono', monospace;
+  }
+
+  .container {
+    max-width: 1280px;
+    margin: 0 auto;
+    padding: 16px;
+    display: grid;
+    gap: 16px;
+  }
+
+  .grid-2 {
+    display: grid;
+    grid-template-columns: 1fr;
+    gap: 16px;
+  }
+
+  .card {
+    background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01)), var(--card);
+    border: 1px solid var(--border);
+    border-radius: 16px;
+    backdrop-filter: blur(10px);
+    box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 20px 40px rgba(0,0,0,.35);
+    padding: 16px;
+  }
+
+  .card h3 {
+    margin: 0 0 12px 0;
+    color: #e0f2f1;
+    font-weight: 1200;
+  }
+
+  .kpi .value { font-size: 28px; font-weight: 700; }
+  .kpi .delta.pos { color: var(--green); }
+  .kpi .delta.neg { color: var(--red); }
+
+  .table {
+    width: 100%;
+    border-collapse: collapse;
+  }
+  .table th, .table td {
+    border-bottom: 1px solid var(--border);
+    padding: 8px;
+    text-align: left;
+    color: var(--text-2);
+  }
+  .table th { color: var(--text-1); }
+
+  .badge {
+    padding: 4px 10px;
+    border-radius: 999px;
+    font-weight: 600;
+    font-size: 12px;
+  }
+  .badge.online {
+    color: #052e16;
+    background: linear-gradient(180deg, #00ff88, #00cc6a);
+    box-shadow: 0 0 16px rgba(0, 255, 136, 0.45);
+  }
+  .badge.offline {
+    color: #450a0a;
+    background: linear-gradient(180deg, #ff8a8a, #ff6b6b);
+    box-shadow: 0 0 16px rgba(255, 107, 107, .45);
+  }
+
+  /* Focus-visible for accessibility */
+  button:focus-visible,
+  a:focus-visible,
+  input:focus-visible,
+  select:focus-visible,
+  textarea:focus-visible {
+    outline: 2px solid var(--focus-ring);
+    outline-offset: 2px;
+  }
+
+  /* Responsive: tablet */
+  @media (max-width: 1024px) {
+    .grid-2 { grid-template-columns: 1fr; }
+  }
+}
+
+/* Responsive grids (outside @layer to avoid Tailwind conflicts) */
+.dashboard-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 20px;
+}
+
+.inventory-stats-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 20px;
+  margin-bottom: 20px;
+}
+
+@keyframes discovery-pulse {
+  0% { transform: scale(0.8); opacity: 0.5; box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.4); }
+  50% { transform: scale(1); opacity: 1; box-shadow: 0 0 20px 10px rgba(0, 255, 136, 0.1); }
+  100% { transform: scale(0.8); opacity: 0.5; box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.4); }
+}
+
+@keyframes animate-fade-in {
+  from { opacity: 0; transform: translateY(8px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+.discovery-pulse {
+  border-radius: 50%;
+  animation: discovery-pulse 2s ease-in-out infinite;
+}
+
+.animate-fade-in {
+  animation: animate-fade-in 0.4s ease-out both;
+}
+
+.tab-pane {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+
+/* Sortable table header hover */
+.custom-table th[style*="cursor"],
+.custom-table th[onclick] {
+  transition: color 0.2s, background 0.2s;
+}
+.custom-table th[style*="cursor"]:hover {
+  color: #00ff88;
+  background: rgba(0, 255, 136, 0.06);
+}
+
+/* Responsive breakpoints */
+@media (max-width: 1200px) {
+  .inventory-stats-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (max-width: 768px) {
+  .dashboard-grid {
+    grid-template-columns: 1fr;
+  }
+  .inventory-stats-grid {
+    grid-template-columns: 1fr;
+  }
+  .container {
+    padding: 10px;
+    gap: 10px;
+  }
+}
+
+@media (max-width: 480px) {
+  .container {
+    padding: 8px;
+    gap: 8px;
+  }
+}
