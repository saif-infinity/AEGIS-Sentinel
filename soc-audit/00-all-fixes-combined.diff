-    needs: lint-frontend
-    defaults:
-      run:
-        working-directory: frontend
     steps:
       - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
-        with:
-          node-version: ${{ env.NODE_VERSION }}
-          cache: npm
-          cache-dependency-path: frontend/package-lock.json
-      - run: npm ci
-      - run: npm run build
-      - uses: actions/upload-artifact@v4
-        with:
-          name: frontend-dist
-          path: frontend/dist/
+      # FIX: docker-compose.yml defined only `redis` while declaring an orphan
+      # `pgdata:` volume, and docker-compose.prod.yml builds `./wazuh`, a directory
+      # that does not exist in the repo.
+      - run: docker compose -f docker-compose.yml config -q
+      - run: docker compose -f docker-compose.prod.yml config -q
+        env:
+          POSTGRES_PASSWORD: x
+          REDIS_PASSWORD: x
 
   deploy:
     name: Deploy Production
     runs-on: ubuntu-latest
-    needs: [build-backend, build-frontend]
-    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
+    needs: [build-backend, build-frontend, build-admin-frontend]
+    if: github.ref == 'refs/heads/master' && github.event_name == 'push'
     environment: production
     steps:
       - uses: actions/checkout@v4
+      # FIX: this step used to `echo` the deploy commands instead of running them —
+      # a green "Deploy Production" check that deployed nothing. It now fails loudly
+      # until real SSH credentials are wired as repository secrets.
       - name: Deploy to server
+        env:
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
         run: |
-          echo "Deploy production deployment step"
-          echo "docker compose -f docker-compose.prod.yml pull"
-          echo "docker compose -f docker-compose.prod.yml up -d --remove-orphans"
+          set -euo pipefail
+          if [ -z "${DEPLOY_HOST:-}" ] || [ -z "${DEPLOY_SSH_KEY:-}" ]; then
+            echo "::error::DEPLOY_HOST / DEPLOY_SSH_KEY secrets are not configured."
+            echo "Either add them, or delete this job — do not ship a deploy step that only echoes."
+            exit 1
+          fi
+          mkdir -p ~/.ssh && printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/id_ed25519 && chmod 600 ~/.ssh/id_ed25519
+          ssh -o StrictHostKeyChecking=accept-new "${DEPLOY_USER:-deploy}@${DEPLOY_HOST}" \
+            'cd /opt/sentinel && git pull --ff-only && docker compose -f docker-compose.prod.yml up -d --build --remove-orphans'
