@@ -1,10 +1,17 @@
 name: Sentinel SOC CI/CD
 
+# FIX: the repo's only branch is `master`, so the previous `branches: [main, develop]`
+# trigger meant this workflow NEVER ran (verified: actions/runs total_count = 0 since
+# the repo was created). Everything it claimed to gate was therefore unverified —
+# including a frontend that cannot compile.
 on:
   push:
-    branches: [main, develop]
+    branches: [master, main, develop]
   pull_request:
-    branches: [main]
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
 
 env:
   PYTHON_VERSION: "3.13"
@@ -23,13 +30,17 @@ jobs:
       - uses: actions/setup-python@v5
         with:
           python-version: ${{ env.PYTHON_VERSION }}
-      - run: pip install -r requirements.txt ruff
-      # insightface tire opencv-python (GUI) -> collision fichiers avec headless
-      - run: pip uninstall -y opencv-python && pip install --force-reinstall --no-deps opencv-python-headless==4.14.0.94
+      # FIX: linting does not need the runtime deps (insightface/onnxruntime/opencv),
+      # and ruff.toml ignored `W503`, a flake8 code ruff does not know — ruff aborted
+      # with "Unknown rule selector" before reading a single file.
+      - run: pip install ruff
       - run: ruff check .
 
-  lint-frontend:
-    name: Lint Frontend
+  # FIX: there was no eslint config and no eslint dependency, so
+  # `npx eslint src --ext .jsx,.js` could only fail. A production build is the gate
+  # that actually catches the class of bug that shipped (missing modules).
+  build-frontend:
+    name: Build Frontend
     runs-on: ubuntu-latest
     defaults:
       run:
@@ -42,15 +53,34 @@ jobs:
           cache: npm
           cache-dependency-path: frontend/package-lock.json
       - run: npm ci
-      - run: npx eslint src --ext .jsx,.js
+      - run: npm run build
+      - uses: actions/upload-artifact@v4
+        with:
+          name: frontend-dist
+          path: frontend/dist/
+
+  build-admin-frontend:
+    name: Build Admin Frontend
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: admin-frontend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: ${{ env.NODE_VERSION }}
+          cache: npm
+          cache-dependency-path: admin-frontend/package-lock.json
+      - run: npm ci
+      - run: npm run build
 
