         image: redis:7
         ports: ["6379:6379"]
     env:
-      DATABASE_URL: postgresql://postgres:test-password-ci-only@localhost:5432/postgres_test
+      # FIX: Settings declares 8 required SecretStr fields. CI supplied 4 and there
+      # was no conftest.py, so every test module failed at collection with a
+      # pydantic ValidationError. tests/conftest.py now provides throwaway defaults
+      # (env values win), and the real DSNs come from here.
+      DATABASE_URL: postgresql+pg8000://postgres:test-password-ci-only@localhost:5432/postgres_test
       REDIS_URL: redis://localhost:6379/0
       JWT_SECRET_KEY: ci-test-only-not-for-production-use-32chars!
       API_KEY: ci-test-only-api-key-not-for-production
+      ADMIN_API_KEY: ci-test-only-admin-key
+      ADMIN_JWT_SECRET: ci-test-only-admin-jwt-secret
+      WAZUH_PASS: ci-test-only
+      WAZUH_INDEXER_PASS: ci-test-only
+      SURICATA_PASS: ci-test-only
+      WAZUH_SSH_PASS: ci-test-only
+      ENVIRONMENT: test
