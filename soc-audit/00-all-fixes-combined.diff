@@ -0,0 +1,11 @@
+[pytest]
+# The backend shipped no pytest configuration at all (no pytest.ini / pyproject.toml /
+# setup.cfg / tox.ini). rootdir resolution then depends on where pytest is invoked
+# from, which is why CI's `pytest --tb=short -q` and a local run can behave
+# differently. Pinning it here makes `pytest` work from any cwd.
+testpaths = tests
+python_files = test_*.py
+addopts = -ra --strict-markers --tb=short
+filterwarnings =
+    ignore::DeprecationWarning:jose.*
+    ignore::DeprecationWarning:passlib.*
