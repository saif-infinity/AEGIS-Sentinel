     name: Test Backend
     runs-on: ubuntu-latest
-    needs: lint-backend
     services:
       postgres:
-        image: postgres:16
+        image: timescale/timescaledb:2.29.1-pg16
         env:
           POSTGRES_USER: postgres
           POSTGRES_PASSWORD: test-password-ci-only
