{
  "name": "aegis-sentinel",
  "productName": "AEGIS Sentinel",
  "version": "1.0.0",
  "description": "System security, health and optimization platform for Windows, macOS and Linux",
  "main": "main.js",
  "author": "AEGIS Labs",
  "license": "Proprietary",
  "private": true,
  "scripts": {
    "start": "electron .",
    "scan": "node lib/scanner.js",
    "test": "node test/smoke.js",
    "demo": "node scripts/build-demo.js",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js && node --check lib/scanner.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.aegislabs.sentinel",
    "productName": "AEGIS Sentinel",
    "copyright": "Copyright © 2026 AEGIS Labs",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AEGIS Sentinel"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "assets/icon.png",
      "category": "Utility;System;"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.2"
  }
}
